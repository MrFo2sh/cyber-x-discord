DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# optional: register commands to one guild instantly instead of globally
GUILD_ID=
# channel name used for weekly MVP announcements
MVP_CHANNEL_NAME=MVPs
# cron for the weekly announcement (default: Sunday 18:00)
WEEKLY_CRON=0 18 * * 0
TIMEZONE=Africa/Cairo
# optional: a role that can award points besides Administrators / Manage Server
ADMIN_ROLE_ID=
# how many users to show in announcements
TOP_N=5
